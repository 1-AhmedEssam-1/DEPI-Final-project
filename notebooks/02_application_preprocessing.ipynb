    "import numpy as np\n",
    "\n",
    "df_features = df_clean.copy()\n",
    "df_features[\"AGE_YEARS\"] = -df_features[\"DAYS_BIRTH\"] / 365.25\n",
    "df_features[\"EMPLOYMENT_YEARS\"] = -df_features[\"DAYS_EMPLOYED\"] / 365.25\n",
    "df_features[\"OWN_CAR_AGE_MISSING\"] = df_features[\"OWN_CAR_AGE\"].isna().astype(int)\n",
    "\n",
    "income = df_features[\"AMT_INCOME_TOTAL\"]\n",
    "valid_income = income.where(income.gt(0) & np.isfinite(income))\n",
    "goods_price = df_features[\"AMT_GOODS_PRICE\"]\n",
    "valid_goods_price = goods_price.where(goods_price.gt(0) & np.isfinite(goods_price))\n",
    "\n",
    "df_features[\"CREDIT_INCOME_RATIO\"] = df_features[\"AMT_CREDIT\"].div(valid_income)\n",
    "df_features[\"ANNUITY_INCOME_RATIO\"] = df_features[\"AMT_ANNUITY\"].div(valid_income)\n",
    "df_features[\"CREDIT_GOODS_RATIO\"] = df_features[\"AMT_CREDIT\"].div(valid_goods_price)\n",
    "ratio_columns = [\"CREDIT_INCOME_RATIO\", \"ANNUITY_INCOME_RATIO\", \"CREDIT_GOODS_RATIO\"]\n",
    "df_features[ratio_columns] = df_features[ratio_columns].replace([np.inf, -np.inf], np.nan)\n",
    "    \n",
    "df_features = df_features.drop(columns=[\"DAYS_BIRTH\", \"DAYS_EMPLOYED\"])\n",
    "display(df_features[[\"AGE_YEARS\", \"EMPLOYMENT_YEARS\", \"OWN_CAR_AGE_MISSING\"] + ratio_columns].head())\n",
    "print(\"Engineered table:\", df_features.shape)"
   ]
