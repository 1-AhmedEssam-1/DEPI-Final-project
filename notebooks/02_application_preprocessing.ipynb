      "Numeric: 109 Text: 16\n"
     ]
    }
   ],
   "source": [
    "numeric_columns = selected_train.select_dtypes(include=\"number\").columns.tolist()\n",
    "categorical_columns = selected_train.select_dtypes(exclude=\"number\").columns.tolist()\n",
    "assert len(numeric_columns) + len(categorical_columns) == len(retained_columns)\n",
    "assert not {\"TARGET\", \"SK_ID_CURR\"}.intersection(retained_columns)\n",
    "for column in categorical_columns:\n",
    "    assert not selected_train[column].eq(\"__MISSING__\").any()\n",
    "    for table in (selected_train, selected_valid):\n",
    "        values = table[column].astype(object)\n",
    "        table[column] = values.where(pd.notna(values), np.nan)\n",
    "print(\"Numeric:\", len(numeric_columns), \"Text:\", len(categorical_columns))"
   ]
  },
  {
   "cell_type": "markdown",
